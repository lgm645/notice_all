# ── 로컬 개발 (기본): PGlite 임베디드 Postgres ──
# 외부 DB·Docker 불필요. .pgdata 디렉터리에 파일로 저장된다.
DB_DRIVER=pglite
PGLITE_DATA=./.pgdata

# ── 배포 / 실제 Postgres (Supabase, Docker 등) ──
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://knu:knu@localhost:5432/knu_notices          # docker-compose 사용 시
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[ref].supabase.co:5432/postgres  # Supabase

# (선택) 스크래퍼 User-Agent 의 연락처 — 정중한 크롤링용

    "typecheck": "tsc --noEmit",
    "db:init": "tsx src/scraper/db-init.ts",
    "scrape": "tsx src/scraper/scrape.ts --all",
    "scrape:cse": "tsx src/scraper/scrape.ts --source cse"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@fontsource/gothic-a1": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/nanum-gothic-coding": "^5.2.8",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "iconv-lite": "^0.6.3",
    "next": "^16.3.2",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }

{
  "name": "knu-notice-board",
  "version": "0.1.0",
  "private": true,
  "description": "경북대·한국장학재단 공지 통합 알리미 — 여러 게시판을 한 화면에서 최신순으로",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
